# ╔══════════════════════════════════════════════════════════════╗
# ║              OpenClaw — Configuration                        ║
# ║  Copiez ce fichier en .env et remplissez vos clés            ║
# ╚══════════════════════════════════════════════════════════════╝

# ── OBLIGATOIRE ────────────────────────────────────────────────

# Clé Tailscale (admin.tailscale.com → Settings → Keys)
# Cochez : Reusable + Pre-authorized
TS_AUTHKEY=tskey-auth-REMPLACEZ-MOI

# Nom de votre machine dans le tailnet
TS_HOSTNAME=openclaw-gateway

# ── ANTHROPIC ─────────────────────────────────────────────────
# Clé API Anthropic (console.anthropic.com → API Keys)
ANTHROPIC_API_KEY=sk-ant-REMPLACEZ-MOI

# ── SIGNAL ────────────────────────────────────────────────────
# Numéro de téléphone dédié au bot Signal (format international)
# Exemple : +33612345678
SIGNAL_BOT_NUMBER=+XXXXXXXXXXX

# Votre numéro personnel Signal (pour le pairing)
SIGNAL_OWNER_NUMBER=+XXXXXXXXXXX

# ── OPTIONNEL — BRAVE SEARCH ──────────────────────────────────
# Clé API Brave Search (api.search.brave.com)
# Laissez vide pour désactiver la recherche web
BRAVE_API_KEY=

# ── OPTIONNEL — OLLAMA ────────────────────────────────────────
# Activer Ollama (modèle local) : true / false
ENABLE_OLLAMA=false

# Modèle Ollama à utiliser si activé
OLLAMA_MODEL=qwen2.5:7b

# ── AVANCÉ ────────────────────────────────────────────────────
# Dossier de configuration OpenClaw (laisser par défaut)
OPENCLAW_CONFIG_DIR=./data/.openclaw
OPENCLAW_WORKSPACE_DIR=./data/.openclaw/workspace

# Fuseau horaire
OPENCLAW_TZ=Europe/Paris

# Token gateway (généré automatiquement au premier lancement)
OPENCLAW_GATEWAY_TOKEN=
